  <ItemGroup>
    <ProjectReference Include="$(SolutionRoot)\test\Elastic.Apm.Tests.Utilities\Elastic.Apm.Tests.Utilities.csproj" />
    <ProjectReference Include="..\OpenTelemetrySample\OpenTelemetrySample.csproj" />
  </ItemGroup>

</Project>
